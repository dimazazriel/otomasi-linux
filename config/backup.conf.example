# =============================================================================
# Contoh konfigurasi backup.sh
# =============================================================================

# Folder yang ingin di-backup (wajib)
SUMBER=~/contoh_data

# Folder tempat arsip disimpan
TUJUAN=~/arsip_backup

# Awalan nama arsip
PREFIX=data_kelompok

# Pola file/folder yang dikecualikan (pisahkan dengan koma)
EXCLUDE=*.tmp,*.log,cache